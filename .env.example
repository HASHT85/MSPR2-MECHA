# ==============================================================================
# MSPR 2 MECHA — Variables d'environnement (EXEMPLE)
# ==============================================================================
# Copier ce fichier en .env et adapter les valeurs

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mecha_db
POSTGRES_USER=mecha_user
POSTGRES_PASSWORD=changeme_in_production

# --- ML Models ---
MODEL_PATH=models/saved_models
DEFAULT_MODEL=random_forest
PREDICTION_THRESHOLD=0.3

# --- Alertes ---
ALERT_TEMP_CRITICAL=100
ALERT_REBUTS_MAX=3.0
ALERT_TRS_MIN=75
ALERT_CYCLE_DEVIATION=15
ALERT_ANOMALY_MAX=10

# --- Grafana ---
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Dashboard ---
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark
