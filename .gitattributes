# Garantit des fins de ligne LF pour les scripts shell/SQL montes dans Docker (evite l'erreur \r sur Windows)
* text=auto
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Scripts natifs Windows en CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
