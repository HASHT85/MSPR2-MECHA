      "targets": [{ "rawSql": "SELECT machine_id, usine_id, machine_profile AS profil, ROUND(temperature::numeric, 1) AS temperature, ROUND(vibration::numeric, 1) AS vibration, predicted_remaining_life::int AS rul, ROUND(downtime_risk::numeric, 3) AS risque, CASE WHEN downtime_risk > 0.7 OR predicted_remaining_life < 30 THEN 4 WHEN downtime_risk > 0.5 OR predicted_remaining_life < 50 THEN 3 WHEN downtime_risk > 0.3 OR temperature > 100 THEN 2 ELSE 1 END AS priorite, CASE WHEN downtime_risk > 0.7 OR predicted_remaining_life < 30 THEN 'ARRET IMMEDIAT - Intervention urgente' WHEN downtime_risk > 0.5 OR predicted_remaining_life < 50 THEN 'Planifier maintenance sous 24h' WHEN downtime_risk > 0.3 OR temperature > 100 THEN 'Surveiller - maintenance prochaine fenetre' ELSE 'RAS - Fonctionnement normal' END AS action FROM v_machine_status WHERE (usine_id = '$usine' OR '$usine' = 'All') ORDER BY priorite DESC, downtime_risk DESC;", "format": "table", "rawQuery": true, "refId": "A" }]
