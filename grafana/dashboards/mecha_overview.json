          "rawSql": "SELECT u.nom AS usine, u.pays, u.nb_machines, ROUND(AVG(d.temperature)::numeric, 1) AS temp_moy, ROUND(AVG(d.vibration)::numeric, 1) AS vibr_moy, ROUND(AVG(d.maintenance_required)::numeric * 100, 1) AS maint_pct, ROUND(AVG(d.anomaly_flag)::numeric * 100, 1) AS anomaly_pct, MIN(d.predicted_remaining_life) AS rul_min, ROUND(AVG(d.downtime_risk)::numeric, 2) AS risque_moy, COUNT(*) AS nb_mesures FROM mecha_data d JOIN mecha_usines u ON d.usine_id = u.usine_id GROUP BY u.nom, u.pays, u.nb_machines ORDER BY maint_pct DESC;",
